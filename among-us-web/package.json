{
  "name": "among-us-web",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev:client": "bun run --filter @among-us/client dev",
    "dev:server": "bun run --filter @among-us/server dev",
    "build:shared": "bun run --filter @among-us/shared build",
    "build:client": "bun run --filter @among-us/client build",
    "build:server": "bun run --filter @among-us/server build",
    "build:spritesheets": "bun run tools/spritesheet-packer/pack.ts",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "free-tex-packer-core": "^0.3.5",
    "typescript": "^5.9.3"
  }
}
